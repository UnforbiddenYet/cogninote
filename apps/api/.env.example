# Database
DB_USER=cogninote_user
DB_PASSWORD=cogninote_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cogninote_dev
DATABASE_URL=postgresql://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME

# App Config
NODE_ENV=development
PORT=3001

# Auth
BETTER_AUTH_SECRET=dev-secret-key-change-in-production-at-least-32-chars-long
BETTER_AUTH_BASE_URL=http://localhost:$PORT
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000

# LightRAG
LIGHTRAG_API_URL=http://localhost:8020
LIGHTRAG_TIMEOUT_MS=10000
LIGHTRAG_MAX_RETRIES=1


