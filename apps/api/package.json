{
  "name": "@mindgraph/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && bun build src/index.ts --outfile build/index.js",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.1.0",
    "jose": "^5.2.0",
    "openai": "^4.50.0",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
